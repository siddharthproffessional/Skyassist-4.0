# SkyAssist 2.0 configuration. Copy to .env (or export) — never commit real keys.

# --- LLM brain (optional; without any, SkyAssist runs in deterministic rules mode) ---
LLM_BACKEND=auto                 # auto | ollama | gemini | groq | rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Demo authentication (synthetic accounts; NOT production identity) ---
PASSENGER_DEMO_PASSWORD=demo123
COORDINATOR_DEMO_PASSWORD=coord123
SKYASSIST_PBKDF2_ITERATIONS=120000

# --- Data & time ---
SKYASSIST_DB=                    # default: ./airport_terminal_journey.sqlite
AIRPORT_TZ=Asia/Dubai            # stored timestamps are UTC; UI shows this zone
DEMO_CLOCK=                      # override the simulated terminal clock, e.g. 10:00
